{
  "experiment_name": "lingbo_vla_aloha_agilex_clean",
  "seed": 42,
  "model": {
    "name": "lingbot-vla-v2-6b",
    "pretrained": "robbyant/lingbot-vla-v2-6b",
    "hf": "https://huggingface.co/robbyant/lingbot-vla-v2-6b",
    "modelscope": "https://modelscope.cn/collections/Robbyant/LingBot-VLA-V2"
  },
  "data": {
    "platform": "robotwin2",
    "embodiment": "aloha_agilex",
    "split": "clean",
    "tasks": "all_50",
    "episodes_per_task": 50,
    "dataset": "TianxingChen/RoboTwin2.0",
    "note": "randomized data is forbidden for training"
  },
  "train": {
    "output_dir": "../../03_模型权重/checkpoint",
    "batch_size": 8,
    "learning_rate": 1.0e-5,
    "max_steps": 100000,
    "save_steps": 5000,
    "logging_steps": 50,
    "gradient_accumulation_steps": 1,
    "mixed_precision": "bf16"
  },
  "robot": {
    "config": "robot_aloha_agilex.json"
  }
}
